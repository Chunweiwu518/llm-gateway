# Build context: repository root. One image, two binaries: /app/billing (gRPC service)
# and /app/notifier (RabbitMQ alert consumer); compose and Kubernetes pick one by command.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/billing ./cmd/billing \
 && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/notifier ./cmd/notifier

FROM alpine:3.20
RUN adduser -D -H -u 10001 app
WORKDIR /app
COPY --from=build /out/billing /app/billing
COPY --from=build /out/notifier /app/notifier
COPY backend/cmd/billing/etc/billing.yaml /app/etc/billing.yaml
USER app
EXPOSE 8081
HEALTHCHECK --interval=5s --retries=20 CMD nc -z 127.0.0.1 8081 || exit 1
ENTRYPOINT ["/app/billing"]
